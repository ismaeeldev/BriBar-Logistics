# English development locale.
#
# The interface language is Spanish (docs/open-questions.md #6) and SRS 29
# excludes a multi-language UI, so there is no switcher in the application.
# This file exists so the people building and reviewing the system can read
# what they are checking.
#
#   pnpm dev:en     run the app in English
#   pnpm dev        run it as the client will see it
#
# Loaded on top of .env, so every other setting is unchanged.
NEXT_PUBLIC_APP_LOCALE="en"
