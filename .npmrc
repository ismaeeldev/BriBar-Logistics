# Prisma generates its client into node_modules/.prisma/client, which sits
# outside pnpm's virtual store. From there, `require('@prisma/client-runtime-utils')`
# walks up to the project's root node_modules - where pnpm, by design, exposes
# only direct dependencies. Hoisting the @prisma scope makes the generated
# client's own runtime dependency resolvable without falling back to
# node-linker=hoisted, which would give up pnpm's strictness for every package.
public-hoist-pattern[]=@prisma/*
