# ---------------------------------------------------------------------------
# BRIBAR Logistics - environment configuration (SRS 31.1)
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; no secret is
# ever committed (SRS 22.5). Every variable below is validated by
# `src/lib/env.ts` at boot - the app refuses to start on a bad value rather
# than failing later at request time.
# ---------------------------------------------------------------------------

# Neon PostgreSQL in staging/production; the local Docker instance in dev.
# Prefer Neon's POOLED connection string for serverless runtimes.
DATABASE_URL="postgresql://bribar:bribar_local_dev@localhost:5434/bribar?schema=public"

# Direct (non-pooled) connection. Prisma Migrate cannot run through a
# transaction pooler, so Neon deployments must set this to the `-direct`
# host. Locally it is the same URL.
DIRECT_DATABASE_URL="postgresql://bribar:bribar_local_dev@localhost:5434/bribar?schema=public"

# Auth.js session/JWT signing secret. Minimum 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Canonical origin of the deployment. Required in production so Auth.js builds
# correct callback URLs behind the BRIBAR private subdomain.
AUTH_URL="http://localhost:3000"

# IANA timezone for all business-facing dates and times (SRS 31.3).
# Audit timestamps are always stored in UTC; this only controls rendering and
# the business date assigned to a new service.
APP_TIMEZONE="Europe/Madrid"

# Session lifetime in days (client decision #9).
SESSION_MAX_AGE_DAYS="20"


# Credentials for the bootstrap administrator created by `pnpm db:seed`
# (SRS 31.2). Change the password immediately after first login, and never
# reuse these values in production.
SEED_ADMIN_NAME="BRIBAR Administrator"
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD=""
