# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - real secrets never leave the machine (SRS 22.5).
# The example and the test fixture carry no real credentials and are tracked.
.env*
!.env.example
!.env.test
!.env.en

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db

# editor
.idea/
.vscode/*
!.vscode/extensions.json

# os
Thumbs.db

# agent/editor tooling, not project config
.claude/
.windsurf/
.agents/
skills-lock.json

# playwright (e2e)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ERP import: the client workbook and any generated bundle live outside git
# (the anonymised copy is versioned under docs/erp-migration/ via the roadmap branch).
/ERP_Transporte_ANONIMIZADO.xlsm
/erp-bundle*.json
/snapshot-*/

# Kept locally, kept out of the GitHub-visible repo: internal dev docs,
# AI-agent working instructions, local-only infra, dev tooling and test
# suites. None of this is needed to run the built app.
/docs/
/docker/
docker-compose.yml
AGENTS.md
CLAUDE.md
/scripts/
/tests/
/e2e/
